# Copy this file to .env (gitignored) and fill in the values.
#
# A variable already exported in your shell wins over this file, so you can
# override any of these for a single command, e.g.:
#     DRIFTLOCK_SKIP=true git commit -m "wip"
#
# Values may be quoted, and a "#" preceded by whitespace starts a comment.

# The key referenced by `api_key = "${DRIFTLOCK_API_KEY}"` in .driftlock.toml.
# Leave empty (or omit) when using a local Ollama, which needs no key.
DRIFTLOCK_API_KEY=your-api-key-here

# Verbose output: raw LLM requests/responses and token usage on stderr.
# Accepts 1/true/yes/on to enable; 0/false/no/off or empty disables.
DRIFTLOCK_DEBUG=0

# Bypass the pre-commit hook. Prefer the one-off shell form above; set this to
# true only when you want the hook disabled locally for a while.
DRIFTLOCK_SKIP=false

# Fail closed when the provider cannot be reached. Recommended in CI, where an
# outage must not pass an unverified change; the GitHub Action sets it for you.
DRIFTLOCK_STRICT_LLM=false
